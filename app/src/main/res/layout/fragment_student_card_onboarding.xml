<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="15dp"
    android:paddingTop="32dp"
    android:background="#D9141517"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.user.StudentCardOnboardingFragment">

    <ImageView
        android:id="@+id/imageView_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:background="@drawable/background_white3_circle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_studentcard_black5" />

    <ImageView
        android:id="@+id/imageView_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="51dp"
        android:layout_marginEnd="44dp"
        android:src="@drawable/ic_arrow"
        app:layout_constraintEnd_toEndOf="@+id/imageView_card"
        app:layout_constraintTop_toTopOf="@+id/imageView_card" />

    <TextView
        android:id="@+id/textView_onboarding"
        style="@style/Text_Regular_14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="4dp"
        android:text="학생증을 등록하고,\n우리 대학의 특별한 혜택을 받아보세요!"
        android:textColor="@color/white"
        app:layout_constraintEnd_toStartOf="@+id/imageView_arrow"
        app:layout_constraintStart_toStartOf="@+id/imageView_studentcard"
        app:layout_constraintTop_toTopOf="@+id/imageView_arrow" />

    <ImageView
        android:id="@+id/imageView_studentcard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:src="@drawable/img_studentcard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView_onboarding" />

    <Button
        android:id="@+id/button_register"
        style="@style/NextButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="등록하기"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView_studentcard"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/button_next"
        style="@style/Text_Medi_18"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="15.5dp"
        android:text="다음에"
        android:textColor="@color/black_5"
        app:layout_constraintEnd_toEndOf="@+id/button_register"
        app:layout_constraintStart_toStartOf="@+id/button_register"
        app:layout_constraintTop_toBottomOf="@+id/button_register" />
</androidx.constraintlayout.widget.ConstraintLayout>