<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white_3"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.home.HomeFragment">

    <include
        android:id="@+id/toolbar"
        layout="@layout/toolbar_logo_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:overScrollMode="never"
        android:background="@drawable/background_tab"
        app:tabBackground="@drawable/selector_tab"
        android:layout_marginHorizontal="20dp"
        app:tabPaddingBottom="4dp"
        app:tabPaddingTop="4dp"
        app:tabPaddingEnd="4dp"
        app:tabPaddingStart="4dp"
        android:textAlignment="center"
        android:foregroundGravity="center"
        app:tabTextAppearance="@style/Text_Semi_14"
        app:tabTextColor="@color/black_10"
        app:tabSelectedTextColor="@color/black_30"
        app:tabIndicatorColor="@color/transparent"
        app:tabIndicator="@null"
        app:tabMinWidth="65dp"
        app:tabGravity="fill"
        app:tabRippleColor="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewpager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="19dp"
        android:background="@color/transparent"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tab"/>
</androidx.constraintlayout.widget.ConstraintLayout>