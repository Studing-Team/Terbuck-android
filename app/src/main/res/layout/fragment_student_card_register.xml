<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.user.StudentCardRegisterFragment">

    <include
        android:id="@+id/toolbar"
        layout="@layout/toolbar_back_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:layout_marginTop="35dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/textView_title"
                style="@style/Title_Semi_20"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="25dp"
                android:text="혜택을 받기 위해\n학생증을 등록해주세요"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textView_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="25dp"
                android:text="학생증 등록은 24시간 안에 마무리 할게요 :)"
                android:textColor="@color/black_30"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="@+id/textView_title"
                app:layout_constraintTop_toBottomOf="@+id/textView_title" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imageView_student_card"
                android:layout_width="0dp"
                android:layout_height="190dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                android:scaleType="centerCrop"
                android:src="@drawable/background_white5_radius16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView_description"
                app:shapeAppearanceOverlay="@style/RoundSector16" />

            <TextView
                android:id="@+id/textView_image_description"
                style="@style/Caption_Medi_12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="학생증 이미지 넣기"
                android:textColor="@color/black_10"
                app:layout_constraintBottom_toBottomOf="@+id/imageView_student_card"
                app:layout_constraintEnd_toEndOf="@+id/imageView_student_card"
                app:layout_constraintStart_toStartOf="@+id/imageView_student_card"
                app:layout_constraintTop_toTopOf="@+id/imageView_student_card" />

            <EditText
                android:id="@+id/editText_name"
                style="@style/Text_Regular_14"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:background="@drawable/background_white5_radius8"
                android:ems="10"
                android:hint="이름을 적어주세요"
                android:inputType="text"
                android:paddingHorizontal="15dp"
                android:paddingVertical="16dp"
                android:textColorHint="@color/black_10"
                app:layout_constraintEnd_toEndOf="@+id/imageView_student_card"
                app:layout_constraintStart_toStartOf="@+id/imageView_student_card"
                app:layout_constraintTop_toBottomOf="@+id/imageView_student_card" />

            <EditText
                android:id="@+id/editText_student_id"
                style="@style/Text_Regular_14"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/background_white5_radius8"
                android:ems="10"
                android:hint="학번을 적어주세요"
                android:inputType="number"
                android:paddingHorizontal="15dp"
                android:paddingVertical="16dp"
                android:textColorHint="@color/black_10"
                app:layout_constraintEnd_toEndOf="@+id/editText_name"
                app:layout_constraintStart_toStartOf="@+id/editText_name"
                app:layout_constraintTop_toBottomOf="@+id/editText_name" />

            <Button
                android:id="@+id/button_register"
                style="@style/NextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="98dp"
                android:enabled="false"
                android:text="등록하기"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/editText_student_id"
                app:layout_constraintVertical_bias="1.0" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>