<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.terbuck.MapFragment">

    <!-- FrameLayout 으로 MapView 감싸기 -->
    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.naver.maps.map.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent" />

        <include
            android:id="@+id/toolbar"
            layout="@layout/toolbar_search_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="15dp"
            android:layout_gravity="top" />
    </FrameLayout>

    <include
        layout="@layout/row_store_map"
        android:id="@+id/bottomSheet_store_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="15dp"
        android:elevation="10dp"
        android:layout_gravity="bottom" />

    <!-- BottomSheet -->
    <LinearLayout
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="107dp"
        android:orientation="vertical"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <!-- 카테고리 리사이클러뷰 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginBottom="10dp" />

        <!-- Bottom Sheet Content 영역 -->
        <LinearLayout
            android:id="@+id/bottomsheet_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/background_bottomsheet">

            <!-- Handle -->
            <View
                android:id="@+id/handler"
                android:layout_width="30dp"
                android:layout_height="4dp"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/background_bottomsheet_handle" />

            <!-- 스토어 리스트 -->
            <TextView
                android:id="@+id/textView_empty"
                style="@style/Text_Semi_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="60dp"
                android:text="등록된 매장이 없습니다"
                android:textAlignment="center"
                android:textColor="@color/black_10"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView_store"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:nestedScrollingEnabled="true"
                android:overScrollMode="ifContentScrolls"
                android:clipToPadding="false"
                android:paddingBottom="16dp"
                app:layout_behavior="@string/appbar_scrolling_view_behavior" />
        </LinearLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
