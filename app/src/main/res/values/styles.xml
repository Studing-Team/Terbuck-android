        <item name="cornerRadius">8dp</item>
        <item name="android:backgroundTint">@color/green_50</item>
        <item name="android:paddingVertical">12dp</item>
    </style>

    <!-- 이미지 round style -->
    <style name="RoundSector16">
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeTopRight">16dp</item>
        <item name="cornerSizeBottomRight">16dp</item>
        <item name="cornerSizeBottomLeft">16dp</item>
        <item name="cornerFamily">rounded</item>
    </style>

    <style name="RoundSector14">
        <item name="cornerSizeTopLeft">14.37dp</item>
        <item name="cornerSizeTopRight">14.37dp</item>
        <item name="cornerSizeBottomRight">14.37dp</item>
        <item name="cornerSizeBottomLeft">14.37dp</item>
