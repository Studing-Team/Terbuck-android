    <!-- NEXT Button -->
    <style name="NextButton" parent="Text_Semi_18">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">20dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:backgroundTint">@drawable/background_button</item>
        <item name="android:paddingVertical">15.5dp</item>
    </style>

    <style name="DialogButton8" parent="Text_Semi_18">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:backgroundTint">@color/black_5</item>
        <item name="android:paddingVertical">12dp</item>
    </style>

    <style name="DialogButton16" parent="Text_Semi_18">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:backgroundTint">@color/black_5</item>
        <item name="android:paddingVertical">15.5dp</item>
    </style>

    <style name="DialogButtonCancel" parent="Text_Semi_14">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:backgroundTint">@color/black_5</item>
